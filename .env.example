# OpenAlgo Trading Agent - environment template
# Copy to .env and fill in the blanks. .env is gitignored; this file is not.

# ---------------------------------------------------------------------------
# OpenAlgo
# ---------------------------------------------------------------------------
# Get the API key from the running OpenAlgo web app after logging in with your broker.
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS_URL=ws://127.0.0.1:8765
OPENALGO_API_VERSION=v1
# Seconds. The SDK default is 120, far too long for a chat UI.
OPENALGO_TIMEOUT=15
OPENALGO_INSTRUMENTS_TIMEOUT=30

# ---------------------------------------------------------------------------
# Model - LiteLLM, so any provider works (cloud or local)
# ---------------------------------------------------------------------------
# There is ONE key and ONE optional base URL. The PREFIX on LITELLM_MODEL decides
# the provider, and LITELLM_API_KEY is that provider's key, whichever it is.
#
# The agent needs TOOL CALLING. Any model you pick must support it.

LITELLM_MODEL=baseten/deepseek-ai/DeepSeek-V4-Flash-0731
LITELLM_API_KEY=
# Leave empty to use the provider's own default endpoint. Only set it to override.
LITELLM_API_BASE=

LITELLM_TEMPERATURE=0.2
LITELLM_TOP_P=1.0
# For a reasoning model this is load-bearing: too small and the whole budget goes to
# hidden reasoning, so the reply comes back EMPTY rather than short.
LITELLM_MAX_TOKENS=4096
# Sends stream_options={"include_usage": true} for token accounting. Skipped
# automatically for local providers, which reject unknown fields.
LITELLM_INCLUDE_USAGE=1

# Thinking / reasoning effort. Empty leaves the provider's own default alone.
# Values: none | minimal | low | medium | high
#
#   none  = turn thinking OFF where the provider supports it.
#           Ollama: works. LiteLLM maps this to Ollama's boolean `think` flag.
#           Measured on gemma4:e4b: 1869 thinking chars and 18.4s -> 0 chars and 7.8s.
#           On Ollama any of low/medium/high just means "on"; there is no gradation.
#
#           Baseten DeepSeek V4 Flash: "none" does NOT stop it reasoning. The value is
#           passed through and scales the budget (low ~1283 reasoning tokens,
#           high ~1498), but there is no off switch.
#
# WARNING: on a reasoning model the hidden reasoning is billed from the SAME budget as
# the reply. Measured: effort=high with LITELLM_MAX_TOKENS=1500 returned EMPTY content.
# If you raise this, keep LITELLM_MAX_TOKENS at 4096 or more.
LITELLM_REASONING_EFFORT=

# --- How to configure each provider ----------------------------------------
#
# 1. BASETEN (the default)
#    LITELLM_MODEL=baseten/deepseek-ai/DeepSeek-V4-Flash-0731
#    LITELLM_API_KEY=<your baseten key>
#    LITELLM_API_BASE=
#
# 2. OPENAI
#    LITELLM_MODEL=openai/gpt-5.2
#    LITELLM_API_KEY=sk-<your openai key>
#    LITELLM_API_BASE=
#
# 3. LOCAL, via OLLAMA - no key at all
#    Start it with `ollama serve`, pull a TOOL-CAPABLE model, then:
#    LITELLM_MODEL=ollama_chat/llama3.1
#    LITELLM_API_KEY=
#    LITELLM_API_BASE=
#
#    Use the ollama_chat/ prefix, not ollama/. Check tool support with
#    `ollama show <model>` and look for "tools" in the capabilities list; the agent
#    reads that at startup and tells LiteLLM, because LiteLLM's own model table is
#    stale and would otherwise fall back to a broken JSON-emulation path.
#    A remote Ollama box:  LITELLM_API_BASE=http://192.168.1.50:11434
#
#    Local models are much weaker at picking between many tools. See the README.
#
# Other providers follow the same shape - set the prefix and the one key:
#    anthropic/claude-sonnet-5 | gemini/gemini-3-pro | groq/llama-3.3-70b-versatile
#    openrouter/anthropic/claude-sonnet-5 | lm_studio/<model>
# Any OpenAI-compatible endpoint:
#    LITELLM_MODEL=openai/<model>   LITELLM_API_BASE=https://your-host/v1

# ---------------------------------------------------------------------------
# Risk controls - enforced in Python, after human confirmation, before the broker
# ---------------------------------------------------------------------------
# Master switch. false means the order tools are not registered with the agent at all.
TRADING_ENABLED=false
# Refuse every order while OpenAlgo is in live mode. Keep true until you mean it.
REQUIRE_ANALYZER_MODE=true
# Tags orders in the OpenAlgo order book so they are attributable.
DEFAULT_STRATEGY_NAME=TradingAgent

MAX_ORDER_VALUE=100000
MAX_ORDER_QUANTITY=1000
MAX_ORDERS_PER_SESSION=25
# Reject a LIMIT price more than this percent away from LTP.
MAX_PRICE_DEVIATION_PCT=20
# Suppress an identical order repeated within this many seconds.
DUPLICATE_ORDER_WINDOW_SEC=10

ALLOWED_EXCHANGES=NSE,NFO,BSE,BFO,MCX,CDS
ALLOWED_PRODUCTS=MIS,CNC,NRML
SYMBOL_DENYLIST=

# Creating this file stops every mutating tool immediately, without restarting.
KILL_SWITCH_FILE=data/KILL

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8088
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
DB_PATH=data/trading.db
AUDIT_DIR=data/audit
TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Optional alert channels (OpenAlgo relays these; no extra credentials needed here)
# ---------------------------------------------------------------------------
# Your OpenAlgo login id, used as the Telegram notify target.
OPENALGO_TELEGRAM_USERNAME=
# Default WhatsApp recipient, digits with country code, e.g. 919876543210.
WHATSAPP_DEFAULT_TO=

# ---------------------------------------------------------------------------
# Tool profile
# ---------------------------------------------------------------------------
# "full" exposes all 43 tools. "lean" exposes a 15-tool subset that small local
# models can actually choose between. Empty picks automatically: lean for local
# providers, full otherwise.
TOOL_PROFILE=
