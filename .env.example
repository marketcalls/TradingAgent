# OpenAlgo Trading Agent - environment template
# Copy to .env and fill in the blanks. .env is gitignored; this file is not.

# ---------------------------------------------------------------------------
# OpenAlgo
# ---------------------------------------------------------------------------
# Get the API key from the running OpenAlgo web app after logging in with your broker.
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS_URL=ws://127.0.0.1:8765
OPENALGO_API_VERSION=v1
# Seconds. The SDK default is 120, far too long for a chat UI.
OPENALGO_TIMEOUT=15
OPENALGO_INSTRUMENTS_TIMEOUT=30

# ---------------------------------------------------------------------------
# Model - LiteLLM, so any provider works (cloud or local)
# ---------------------------------------------------------------------------
# There is ONE key and ONE optional base URL. The PREFIX on LITELLM_MODEL decides
# the provider, and LITELLM_API_KEY is that provider's key, whichever it is.
#
# The agent needs TOOL CALLING. Any model you pick must support it.

LITELLM_MODEL=baseten/deepseek-ai/DeepSeek-V4-Flash-0731
LITELLM_API_KEY=
# Leave empty to use the provider's own default endpoint. Only set it to override.
LITELLM_API_BASE=

LITELLM_TEMPERATURE=0.2
LITELLM_TOP_P=1.0
# For a reasoning model this is load-bearing: too small and the whole budget goes to
# hidden reasoning, so the reply comes back EMPTY rather than short.
LITELLM_MAX_TOKENS=4096
# Sends stream_options={"include_usage": true} for token accounting. Skipped
# automatically for local providers, which reject unknown fields.
LITELLM_INCLUDE_USAGE=1

# Thinking / reasoning effort - the DEFAULT for new chats. The user can change it
# per message from the header, and that choice is remembered per model. This value
# still matters: it is what a fresh browser starts on, and what any non-UI caller
# (curl, scripts, the tests) gets when it sends no preference of its own.
# Empty leaves the provider's own default alone.
# Values: none | minimal | low | medium | high
#
# Whether this does anything depends on the MODEL, and the app works it out for you.
# Two separate questions: does the model reason at all, and does the provider accept
# the reasoning_effort parameter. If either answer is no, the setting is ignored (with
# a warning in the log) and the UI shows no thinking control.
#
#   Ollama, tool-capable model  -> Off / On. LiteLLM maps effort onto Ollama's boolean
#                                  `think` flag, so low/medium/high all just mean "on".
#                                  Measured on gemma4:e4b: 1869 thinking chars and
#                                  18.4s, down to 0 and 6.7s with none. Worth setting.
#   openai/o3, claude-sonnet-4-5 -> full scale.
#   openai/gpt-4o, groq llama    -> nothing; not reasoning models.
#   baseten DeepSeek V4 Flash    -> nothing. It DOES reason, but Baseten rejects the
#                                  parameter outright (UnsupportedParamsError), so the
#                                  amount cannot be controlled at all.
#
# If you measure this yourself, do NOT set litellm.drop_params = True: it silently
# discards reasoning_effort, so every level becomes the same request and any difference
# you see is noise. An earlier version of this file claimed DeepSeek's effort scaled the
# budget; that came from exactly this mistake and was wrong.
#
# WARNING, unrelated to the setting above: on any reasoning model the hidden reasoning
# is billed from the SAME budget as the reply, so too small a LITELLM_MAX_TOKENS returns
# EMPTY content rather than a short answer. Keep it at 4096 or more.
LITELLM_REASONING_EFFORT=

# --- How to configure each provider ----------------------------------------
#
# 1. BASETEN (the default)
#    LITELLM_MODEL=baseten/deepseek-ai/DeepSeek-V4-Flash-0731
#    LITELLM_API_KEY=<your baseten key>
#    LITELLM_API_BASE=
#
# 2. OPENAI
#    LITELLM_MODEL=openai/gpt-5.6-sol        (or openai/gpt-5.6-luna, openai/o3, openai/gpt-4o)
#    LITELLM_API_KEY=sk-<your openai key>
#    LITELLM_API_BASE=
#
#    NOTE for the gpt-5.6 family (-sol and -luna): on /v1/chat/completions they refuse
#    to combine function tools with any reasoning effort except "none". Since this agent
#    always sends tools, thinking is pinned off for them automatically - you do not need
#    to set anything, and a stray LITELLM_REASONING_EFFORT is overridden with a warning.
#    Measured: none returns a correct tool call in 1.5-2.3s, while minimal/low/medium/
#    high all fail with "Function tools with reasoning_effort are not supported".
#
# 3. LOCAL, via OLLAMA - no key at all
#    Start it with `ollama serve`, pull a TOOL-CAPABLE model, then:
#    LITELLM_MODEL=ollama_chat/llama3.1
#    LITELLM_API_KEY=
#    LITELLM_API_BASE=
#
#    Use the ollama_chat/ prefix, not ollama/. Check tool support with
#    `ollama show <model>` and look for "tools" in the capabilities list; the agent
#    reads that at startup and tells LiteLLM, because LiteLLM's own model table is
#    stale and would otherwise fall back to a broken JSON-emulation path.
#    A remote Ollama box:  LITELLM_API_BASE=http://192.168.1.50:11434
#
#    Local models are much weaker at picking between many tools. See the README.
#
# Other providers follow the same shape - set the prefix and the one key:
#    anthropic/claude-sonnet-5 | gemini/gemini-3-pro | groq/llama-3.3-70b-versatile
#    openrouter/anthropic/claude-sonnet-5 | lm_studio/<model>
# Any OpenAI-compatible endpoint:
#    LITELLM_MODEL=openai/<model>   LITELLM_API_BASE=https://your-host/v1

# ---------------------------------------------------------------------------
# Risk controls - enforced in Python, after human confirmation, before the broker
# ---------------------------------------------------------------------------
# Master switch. false means the order tools are not registered with the agent at all.
TRADING_ENABLED=false
# Refuse every order while OpenAlgo is in live mode. Keep true until you mean it.
REQUIRE_ANALYZER_MODE=true
# Tags orders in the OpenAlgo order book so they are attributable.
DEFAULT_STRATEGY_NAME=TradingAgent

# Risk criteria. The default protection is ACCOUNT-RELATIVE, because no fixed rupee
# figure suits every account: a cap that suits a retail trader blocks a desk punching
# 5 crore, and one that suits the desk protects nobody.
#
# The primary guard. Refuse an order whose REQUIRED MARGIN exceeds this share of
# available funds. Margin is the right measure, not notional: one NIFTY futures lot is
# ~15.8 lakh of exposure but only ~1.8 lakh of margin, and it is the margin that must be
# there. Scales to any account size. Set 0 to disable.
MAX_ORDER_PCT_OF_FUNDS=90

# Absolute ceilings, OPT-IN. 0 means no ceiling, which is the default. Set these only if
# you want a hard limit on top of the affordability check.
#   MAX_ORDER_VALUE            cash-segment notional, where notional is the actual outlay
#   MAX_DERIVATIVE_ORDER_VALUE F&O EXPOSURE, which is far larger than the margin paid
#   MAX_ORDER_QUANTITY         raw quantity
MAX_ORDER_VALUE=0
MAX_DERIVATIVE_ORDER_VALUE=0
MAX_ORDER_QUANTITY=0
MAX_ORDERS_PER_SESSION=25
# Reject a LIMIT price more than this percent away from LTP.
MAX_PRICE_DEVIATION_PCT=20
# Suppress an identical order repeated within this many seconds.
DUPLICATE_ORDER_WINDOW_SEC=10

ALLOWED_EXCHANGES=NSE,NFO,BSE,BFO,MCX,CDS
ALLOWED_PRODUCTS=MIS,CNC,NRML
SYMBOL_DENYLIST=

# Creating this file stops every mutating tool immediately, without restarting.
KILL_SWITCH_FILE=data/KILL

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8088
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
DB_PATH=data/trading.db
AUDIT_DIR=data/audit
TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Optional alert channels (OpenAlgo relays these; no extra credentials needed here)
# ---------------------------------------------------------------------------
# Your OpenAlgo login id, used as the Telegram notify target.
OPENALGO_TELEGRAM_USERNAME=
# Default WhatsApp recipient, digits with country code, e.g. 919876543210.
WHATSAPP_DEFAULT_TO=

# ---------------------------------------------------------------------------
# Tool profile
# ---------------------------------------------------------------------------
# "full" exposes all 43 tools. "lean" exposes a 15-tool subset that small local
# models can actually choose between. Empty picks automatically: lean for local
# providers, full otherwise.
TOOL_PROFILE=
